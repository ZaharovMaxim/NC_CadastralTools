        <TreeView x:Name="TreeView1" HorizontalAlignment="Center" Height="164" Margin="0,49,0,0" VerticalAlignment="Top" Width="310"/>
        <DataGrid x:Name="DataGrid1" HorizontalAlignment="Center" Height="209" Margin="0,231,0,0" VerticalAlignment="Top" Width="308" AlternationCount="0">

        </DataGrid>
        <Button x:Name="Button1" Content="Создать" HorizontalAlignment="Left" Height="34" Margin="205,10,0,0" VerticalAlignment="Top" Width="114"/>
        <CheckBox x:Name="CheckBox1" Content="Корректировать" HorizontalAlignment="Left" Height="17" Margin="10,15,0,0" VerticalAlignment="Top" Width="116" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>

    </Grid>
</UserControl>
